{
  "name": "YBM Picker-Packer Android Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/nordcominc/devcontainer-features/android-sdk:1.2.0": {
      "platform": "36",
      "build_tools": "36.0.0"
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "secrets": {
    "ANDROID_KEYSTORE_BASE64": {
      "description": "Base64-encoded permanent YBM Picker-Packer Android release keystore."
    },
    "ANDROID_KEYSTORE_PASSWORD": {
      "description": "Password for the YBM Picker-Packer Android release keystore."
    },
    "ANDROID_KEY_ALIAS": {
      "description": "Alias of the YBM Picker-Packer Android release signing key."
    },
    "ANDROID_KEY_PASSWORD": {
      "description": "Password for the YBM Picker-Packer Android release signing key."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "expo.vscode-expo-tools",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "RELEASE_SETUP.md"
      ]
    }
  },
  "remoteEnv": {
    "ANDROID_HOME": "/usr/local/lib/android",
    "ANDROID_SDK_ROOT": "/usr/local/lib/android"
  },
  "forwardPorts": [
    8081,
    19000,
    19001,
    19002
  ],
  "portsAttributes": {
    "8081": {
      "label": "Metro",
      "onAutoForward": "notify"
    }
  }
}
