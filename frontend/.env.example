EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Development-only quick login. Keep false/empty in production builds.
EXPO_PUBLIC_DEV_QUICK_LOGIN=false
EXPO_PUBLIC_DEV_PICKER_EMAIL=picker.test@yourbuildmart.com
EXPO_PUBLIC_DEV_PICKER_PASSWORD=replace-with-development-password
EXPO_PUBLIC_DEV_PACKER_EMAIL=packer.test@yourbuildmart.com
EXPO_PUBLIC_DEV_PACKER_PASSWORD=replace-with-development-password
