{
  "expo": {
    "name": "ybm-picker-packer",
    "slug": "ybm-picker-packer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ybm-picker-packer",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YBM Picker & Packer to use the camera to scan warehouse barcodes."
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071A5E",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.aaditya001.ybmpickerpacker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a17ee45f-effe-495b-ad02-ce22d84e826a"
      }
    }
  }
}
