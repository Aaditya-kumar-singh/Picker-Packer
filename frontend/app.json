{
  "expo": {
    "name": "ybm-picker-packer",
    "slug": "ybm-picker-packer",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/ybm-app-mark.png",
    "scheme": "ybm-picker-packer",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YBM Picker & Packer to use the camera to scan warehouse barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071A5E",
        "foregroundImage": "./assets/images/ybm-app-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.aaditya001.ybmpickerpacker"
    },
    "web": {
      "favicon": "./assets/images/ybm-app-mark.png"
    },
    "extra": {
      "router": {}
    }
  }
}
